{"id": "preklad-001", "category": "preklad", "prompt": "Prelož do slovenčiny. Vráť len preklad.\n\nThe meeting has been postponed until next Tuesday.", "checks": [{"type": "regex", "value": "\\butor(ok|ka)\\b", "flags": "i"}, {"type": "regex", "value": "odlož|presun", "flags": "i"}, {"type": "not_regex", "value": "\\bmeeting|mítin", "flags": "i"}]}
{"id": "preklad-002", "category": "preklad", "prompt": "Prelož do slovenčiny. Vráť len preklad.\n\nPlease find attached the invoice for March.", "checks": [{"type": "regex", "value": "príloh|prilož|pripáj", "flags": "i"}, {"type": "regex", "value": "faktúr", "flags": "i"}, {"type": "regex", "value": "\\bmarec\\b", "flags": "i"}, {"type": "not_regex", "value": "attach|invoice", "flags": "i"}]}
{"id": "preklad-003", "category": "preklad", "prompt": "Prelož do slovenčiny. Vráť len preklad.\n\nIt's raining cats and dogs.", "checks": [{"type": "regex", "value": "\\b(leje|lialo|prší|pršalo)\\b", "flags": "i"}, {"type": "not_regex", "value": "mač(k|ie)|\\bps(y|i|ov)\\b", "flags": "i"}], "notes": "idióm, nie doslovný preklad"}
{"id": "preklad-004", "category": "preklad", "prompt": "Prelož do slovenčiny. Vráť len preklad.\n\nBreak a leg!", "checks": [{"type": "regex", "value": "zlom(te)? väz|veľa šťastia|držím (ti|Vám|vám) palce", "flags": "i"}, {"type": "not_regex", "value": "\\bnoh", "flags": "i"}], "notes": "idióm"}
{"id": "preklad-005", "category": "preklad", "prompt": "Prelož do slovenčiny. Vráť len preklad.\n\nHe is a very sympathetic person.", "checks": [{"type": "regex", "value": "súcit|empat|chápav|ohľaduplný|vnímav|citliv", "flags": "i"}, {"type": "not_regex", "value": "sympatick", "flags": "i"}], "notes": "false friend: sympathetic ≠ sympatický"}
{"id": "preklad-006", "category": "preklad", "prompt": "Prelož do slovenčiny. Vráť len preklad.\n\nEventually, we found the problem.", "checks": [{"type": "regex", "value": "\\b(nakoniec|napokon|koniec koncov|nakoniec sme)\\b", "flags": "i"}, {"type": "not_regex", "value": "eventuáln", "flags": "i"}], "notes": "false friend: eventually ≠ eventuálne"}
{"id": "preklad-007", "category": "preklad", "prompt": "Prelož do slovenčiny. Vráť len preklad.\n\nThe actual cost was higher than expected.", "checks": [{"type": "regex", "value": "skutočn", "flags": "i"}, {"type": "not_regex", "value": "aktuáln", "flags": "i"}], "notes": "false friend: actual ≠ aktuálny"}
{"id": "preklad-008", "category": "preklad", "prompt": "Prelož do slovenčiny. Vráť len preklad.\n\nThe company hired a new manager.", "checks": [{"type": "regex", "value": "\\bnového (manažéra|vedúceho|riaditeľa)\\b", "flags": "i"}, {"type": "not_regex", "value": "\\bnový manažér\\b|\\bmanagera\\b", "flags": "i"}]}
{"id": "preklad-009", "category": "preklad", "prompt": "Prelož do slovenčiny. Vráť len preklad.\n\nOur team will deliver the project on time.", "checks": [{"type": "regex", "value": "projekt", "flags": "i"}, {"type": "regex", "value": "\\b(načas|včas|v termíne|v stanovenom termíne)\\b", "flags": "i"}, {"type": "not_regex", "value": "\\bteam\\b|on time", "flags": "i"}]}
{"id": "preklad-010", "category": "preklad", "prompt": "Prelož do slovenčiny. Vráť len preklad.\n\nTwo hundred and fifty people attended the conference.", "checks": [{"type": "regex", "value": "\\b(250|dvesto ?päťdesiat) (ľudí|účastníkov|osôb)\\b", "flags": "i"}, {"type": "not_regex", "value": "\\bľudia sa zúčastn|\\bpeople\\b", "flags": "i"}], "notes": "genitív pl. po číslovke"}
{"id": "preklad-011", "category": "preklad", "prompt": "Prelož do slovenčiny. Vráť len preklad.\n\nThe doctor said she would call me tomorrow.", "checks": [{"type": "regex", "value": "\\b(lekárka|doktorka)\\b", "flags": "i"}, {"type": "not_regex", "value": "\\b(lekár|doktor) povedal\\b", "flags": "i"}], "notes": "rod podľa zámena she"}
{"id": "preklad-012", "category": "preklad", "prompt": "Prelož do slovenčiny. Vráť len preklad.\n\nI have been living in Bratislava for five years.", "checks": [{"type": "regex", "value": "\\bv Bratislave\\b", "flags": "i"}, {"type": "regex", "value": "\\b(päť|5) rokov\\b", "flags": "i"}, {"type": "not_regex", "value": "\\bsom (bol )?žil\\b", "flags": "i"}]}
{"id": "preklad-013", "category": "preklad", "prompt": "Prelož do slovenčiny. Vráť len preklad.\n\nPlease do not hesitate to contact us if you have any questions.", "checks": [{"type": "regex", "value": "\\b(neváhajte|pokojne|kedykoľvek)\\b", "flags": "i"}, {"type": "regex", "value": "\\b(kontaktovať|obrátiť|obráťte|napíšte|napísať|ozvite|ozvať)\\b", "flags": "i"}, {"type": "not_regex", "value": "\\b(neváhaj|kontaktuj|hesit)\\b", "flags": "i"}]}
{"id": "preklad-014", "category": "preklad", "prompt": "Prelož do slovenčiny. Vráť len preklad.\n\nTwo women were sitting on the bench and talking.", "checks": [{"type": "regex", "value": "\\b(Dve ženy|dve ženy)\\b", "flags": "i"}, {"type": "regex", "value": "\\bsedeli\\b", "flags": "i"}, {"type": "regex", "value": "\\brozprávali|zhovárali|debatovali\\b", "flags": "i"}, {"type": "not_regex", "value": "sedely|rozprávaly|zhováraly|dvaja ženy", "flags": "i"}], "notes": "minulý čas pl. -li"}
